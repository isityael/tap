{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":semanticCommits",
    ":automergeMinor"
  ],
  "pinDigests": false,
  "dependencyDashboardApproval": false,
  "assignees": [ "isityael" ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Apple Mail MCP formula — Forgejo tags",
      "managerFilePatterns": [
        "/^Formula/apple-mail-mcp\\.rb$/"
      ],
      "matchStrings": [
        "url \\\"https://git\\.m0sh1\\.cc/isityael/apple-mail-mcp/archive/v(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tar\\.gz\\\""
      ],
      "depNameTemplate": "https://git.m0sh1.cc/isityael/apple-mail-mcp.git",
      "datasourceTemplate": "git-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "BetterDiscord cask — GitHub releases",
      "managerFilePatterns": [
        "/^Casks/betterdiscord\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "BetterDiscord/Installer",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "ExifCleaner cask — GitHub releases",
      "managerFilePatterns": [
        "/^Casks/exifcleaner\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "szTheory/exifcleaner",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Headlamp cask — GitHub releases",
      "managerFilePatterns": [
        "/^Casks/headlamp\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "kubernetes-sigs/headlamp",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Zenmap cask — nmap.org releases",
      "managerFilePatterns": [
        "/^Casks/zenmap\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "nmap/nmap",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^nmap-(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "fast-cli formula — npm registry",
      "managerFilePatterns": [
        "/^Formula/fast-cli\\.rb$/"
      ],
      "matchStrings": [
        "url \"https://registry\\.npmjs\\.org/fast-cli/-/fast-cli-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tgz\""
      ],
      "depNameTemplate": "fast-cli",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Apple Mail MCP on the fork's v2 release line",
      "matchPackageNames": [
        "https://git.m0sh1.cc/isityael/apple-mail-mcp.git"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "Group all cask updates together",
      "matchFileNames": [ "Casks/**" ],
      "groupName": "cask updates",
      "commitMessageTopic": "cask {{depName}}"
    },
    {
      "description": "Formula updates get individual PRs",
      "matchFileNames": [ "Formula/**" ],
      "commitMessageTopic": "formula {{depName}}"
    },
    {
      "description": "Headlamp is disabled — suppress updates",
      "matchDepNames": [ "kubernetes-sigs/headlamp" ],
      "enabled": true
    }
  ]
}
