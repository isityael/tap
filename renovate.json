{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":semanticCommits",
    ":automergeMinor"
  ],
  "pinDigests": false,
  "dependencyDashboardApproval": false,
  "assignees": [
    "isityael"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Apple Mail MCP formula \u2014 Forgejo tags",
      "managerFilePatterns": [
        "/^Formula/apple-mail-mcp\\.rb$/"
      ],
      "matchStrings": [
        "url \\\"https://git\\.m0sh1\\.cc/isityael/apple-mail-mcp/archive/v(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tar\\.gz\\\""
      ],
      "depNameTemplate": "https://git.m0sh1.cc/isityael/apple-mail-mcp.git",
      "datasourceTemplate": "git-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "BetterDiscord cask \u2014 GitHub releases",
      "managerFilePatterns": [
        "/^Casks/betterdiscord\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "BetterDiscord/Installer",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "ExifCleaner cask \u2014 GitHub releases",
      "managerFilePatterns": [
        "/^Casks/exifcleaner\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "szTheory/exifcleaner",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Headlamp cask \u2014 GitHub releases",
      "managerFilePatterns": [
        "/^Casks/headlamp\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "kubernetes-sigs/headlamp",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Zenmap cask \u2014 nmap.org releases",
      "managerFilePatterns": [
        "/^Casks/zenmap\\.rb$/"
      ],
      "matchStrings": [
        "version \"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "nmap/nmap",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^nmap-(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "fast-cli formula \u2014 npm registry",
      "managerFilePatterns": [
        "/^Formula/fast-cli\\.rb$/"
      ],
      "matchStrings": [
        "url \"https://registry\\.npmjs\\.org/fast-cli/-/fast-cli-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tgz\""
      ],
      "depNameTemplate": "fast-cli",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Apple Mail MCP on the fork's v2 release line",
      "matchPackageNames": [
        "https://git.m0sh1.cc/isityael/apple-mail-mcp.git"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "Group all cask updates together",
      "matchFileNames": [
        "Casks/**"
      ],
      "commitMessageTopic": "cask {{depName}}"
    },
    {
      "description": "Formula updates get individual PRs",
      "matchFileNames": [
        "Formula/**"
      ],
      "commitMessageTopic": "formula {{depName}}"
    },
    {
      "description": "Keep Headlamp updates enabled",
      "matchDepNames": [
        "kubernetes-sigs/headlamp"
      ],
      "enabled": true
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    }
  ],
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "prConcurrentLimit": 1,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  }
}
